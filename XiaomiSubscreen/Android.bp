android_app {
    name: "XiaomiSubscreen",
    srcs: [
        "src/**/*.kt",
        "src/**/*.java",
        "src/**/*.aidl",
    ],
    certificate: "platform",
    privileged: true,
    static_libs: [
        "androidx.core_core-ktx",
        "androidx.appcompat_appcompat",
    ],
    aidl: {
        local_include_dirs: ["src"],
    },
}